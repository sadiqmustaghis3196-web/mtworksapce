# MT Nexus Global Enterprise ERP Configuration Example
NODE_ENV=development
PORT=5000
HOST=127.0.0.1

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

DEFAULT_ORG_CODE="MT-NEXUS-HQ"
DEFAULT_ORG_NAME="MT Nexus Global"

# Exact comma-separated browser origins; production must use HTTPS origins.
APP_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Password-reset email delivery. Add credentials securely; never commit real values.
PUBLIC_APP_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only for the explicit initial provisioning command; remove after use.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
