datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. ORGANIZATION, ROLES & AUTHENTICATION (RBAC)
// ============================================================================

model Organization {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  currency    String       @default("PKR")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  departments Department[]
  projects    Project[]
  clients     Client[]
  employees   Employee[]
}

enum RoleTier {
  EXECUTIVE
  MANAGEMENT
  HR
  FINANCE
  TECHNICAL
  BUSINESS
  OTHER
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  tier        RoleTier
  description String?
  isCustom    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  module      String           // e.g. "dash", "boards", "clientops", "finance", "people", "access"
  action      String           // "view", "create", "edit", "delete", "approve", "reject"
  createdAt   DateTime         @default(now())

  rolePerms   RolePermission[]

  @@unique([module, action])
}

enum RecordScope {
  OWN
  TEAM
  PROJECT
  DEPARTMENT
  ORGANIZATION
}

model RolePermission {
  id           String      @id @default(uuid())
  roleId       String
  permissionId String
  scope        RecordScope @default(OWN)

  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id             String        @id @default(uuid())
  organizationId String
  email          String        @unique
  passwordHash   String
  isActive       Boolean       @default(true)
  isSuperAdmin   Boolean       @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  employee       Employee?
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  taskActivities TaskActivity[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// ============================================================================
// 2. HRM: DEPARTMENTS, EMPLOYEES & INTERNS
// ============================================================================

model Department {
  id             String       @id // e.g. "dept_dev", "dept_admin"
  organizationId String
  name           String
  code           String       @unique
  icon           String?
  description    String?
  headEmployeeId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  head           Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  employees      Employee[]   @relation("DepartmentMembers")
  tasks          Task[]
}

enum WorkArrangement {
  ONSITE
  REMOTE
  HYBRID
  INTERN
}

enum EmploymentStatus {
  ONBOARDING
  PROBATION
  ACTIVE
  ON_LEAVE
  OFFBOARDING
  RESIGNED
  TERMINATED
}

model Employee {
  id             String           @id // e.g. "EMP-101"
  organizationId String
  userId         String?          @unique
  departmentId   String
  employeeCode   String           @unique
  fullName       String
  jobTitle       String
  workMode       WorkArrangement  @default(ONSITE)
  status         EmploymentStatus @default(ACTIVE)
  colorCode      String           @default("#6d3bd2")
  email          String           @unique
  phone          String?
  salaryMonthly  Decimal          @db.Decimal(12, 2)
  leaveBalance   Int              @default(14)
  joiningDate    DateTime         @default(now())
  skills         String[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id])
  user           User?            @relation(fields: [userId], references: [id])
  department     Department       @relation("DepartmentMembers", fields: [departmentId], references: [id])
  headsDepts     Department[]     @relation("DepartmentHead")

  assignedTasks  TaskAssignee[]
  taskUpdates    TaskUpdate[]
  reviewsGiven   TaskReview[]     @relation("Reviewer")
  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  payslips       Payslip[]
  internProfile  InternProfile?   @relation("InternEmployee")
  mentored       InternProfile[]  @relation("Mentor")
  assignedLeads  Lead[]
  projectMembers ProjectMember[]
  dailyWorks     DailyClientWork[]

  @@index([departmentId])
  @@index([status])
}

model InternProfile {
  id             String    @id @default(uuid())
  employeeId     String    @unique
  mentorId       String?
  durationWeeks  Int       @default(12)
  currentWeek    Int       @default(1)
  evaluationPct  Int       @default(70)
  learningGoals  String?
  certifiedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee       Employee  @relation("InternEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  mentor         Employee? @relation("Mentor", fields: [mentorId], references: [id])
}

// ============================================================================
// 3. PROJECTS & TASKS (KANBAN SPRINTS & WORKFLOW GATES)
// ============================================================================

model Project {
  id             String          @id // e.g. "PRJ-01"
  organizationId String
  clientId       String?
  name           String
  category       String
  status         String          @default("Active")
  budget         Decimal?        @db.Decimal(12, 2)
  contractValue  Decimal?        @db.Decimal(12, 2)
  deadline       DateTime?
  projectManager String?
  description    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  client         Client?         @relation(fields: [clientId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  employeeId String
  role       String   @default("Member")
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model Task {
  id                 Int              @id // Preserved numeric task IDs (101, 102, ...)
  projectId          String?
  departmentId       String?
  title              String
  description        String?
  category           String           @default("Web App")
  stage              Int              @default(0) // 0: Upcoming, 1: Today To Do, 2: In Progress, 3: Review, 4: Done, 5: Reject
  priority           String           @default("Medium") // Low, Medium, High, Urgent, Critical
  dueDate            DateTime?
  dueTime            String?          @default("18:00")
  estimatedHours     Float            @default(0)
  actualHours        Float            @default(0)
  progress           Int              @default(0)
  activities         TaskActivity[]
  voiceAlertsEnabled Boolean          @default(true)
  approvedBy         String?
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectReason       String?
  tags               String[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  project            Project?         @relation(fields: [projectId], references: [id])
  department         Department?      @relation(fields: [departmentId], references: [id])
  assignees          TaskAssignee[]
  updates            TaskUpdate[]
  reviews            TaskReview[]
  checklists         TaskChecklist[]
  attachments        TaskAttachment[]
  dependencies       TaskDependency[] @relation("TaskAsSource")
  dependentOn        TaskDependency[] @relation("TaskAsTarget")
  notifications      Notification[]
  escalations        EscalationLog[]
  voiceLogs          VoiceCallLog[]

  @@index([stage])
  @@index([priority])
  @@index([dueDate])
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     Int
  employeeId String
  isOwner    Boolean  @default(false)
  assignedAt DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
}

model TaskUpdate {
  id         String    @id @default(uuid())
  taskId     Int
  employeeId String?
  authorName String
  content    String
  imageUrl   String?
  createdAt  DateTime  @default(now())

  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id])
}

model TaskReview {
  id          String   @id @default(uuid())
  taskId      Int
  reviewerId  String
  status      String   // APPROVED or REJECTED
  comments    String?
  submittedAt DateTime @default(now())

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer    Employee @relation("Reviewer", fields: [reviewerId], references: [id])
}

model TaskChecklist {
  id        String              @id @default(uuid())
  taskId    Int
  title     String
  createdAt DateTime            @default(now())

  task      Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items     TaskChecklistItem[]
}

model TaskChecklistItem {
  id          String        @id @default(uuid())
  checklistId String
  text        String
  isDone      Boolean       @default(false)
  assignee    String?
  dueDate     String?
  createdAt   DateTime      @default(now())

  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     Int
  fileName   String
  fileType   String   // pdf, image, doc, sheet, zip
  fileSize   String
  fileUrl    String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          Int
  dependentTaskId Int
  dependencyType  String   @default("Blocks") // "Blocks" or "BlockedBy"
  createdAt       DateTime @default(now())

  task            Task     @relation("TaskAsSource", fields: [taskId], references: [id], onDelete: Cascade)
  dependentTask   Task     @relation("TaskAsTarget", fields: [dependentTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependentTaskId])
}

// ============================================================================
// 4. CLIENTS & CLIENT OPERATIONS RETAINERS
// ============================================================================

model Client {
  id             String          @id // e.g. "LEAD-101", "CLI-01"
  organizationId String
  companyName    String
  contactName    String
  email          String
  phone          String?
  portalEnabled  Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  projects       Project[]
  contracts      Contract[]
  invoices       Invoice[]
  tickets        SupportTicket[]
}

model Contract {
  id               String                @id // e.g. "CTR-2026-001"
  clientId         String
  name             String
  category         String
  services         String[]
  startDate        DateTime
  endDate          DateTime
  durationMonths   Int
  retainerAmount   Decimal               @db.Decimal(12, 2)
  currency         String                @default("PKR")
  billingCycle     String                @default("Monthly")
  manager          String
  monthlyProgress  Int                   @default(0)
  daysRemaining    Int                   @default(30)
  status           String                @default("Active") // Draft, Active, On Hold, Completed, Cancelled
  healthScore      Int                   @default(90)
  escalationStatus String                @default("Normal")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  client           Client                @relation(fields: [clientId], references: [id])
  dailyWorks       DailyClientWork[]
  deliverables     RetainerDeliverable[]
  kpis             RetainerKPI[]
}

model DailyClientWork {
  id          String    @id @default(uuid())
  contractId  String
  employeeId  String?
  date        DateTime  @default(now())
  taskTitle   String
  deliverable String?
  hoursSpent  Float     @default(0)
  status      String    @default("Done") // Done, In Progress, Blocked
  notes       String?
  createdAt   DateTime  @default(now())

  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id])
}

model RetainerDeliverable {
  id          String   @id @default(uuid())
  contractId  String
  title       String
  frequency   String   @default("Monthly")
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model RetainerKPI {
  id          String   @id @default(uuid())
  contractId  String
  metric      String
  target      String
  actual      String
  unit        String
  change      String?
  createdAt   DateTime @default(now())

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 5. CRM LEADS & HIRING ATS CANDIDATES
// ============================================================================

model Lead {
  id                 String       @id // e.g. "LEAD-201"
  clientName         String
  company            String
  budget             String
  assignedEmployeeId String?
  repName            String?
  stage              String       @default("New Lead") // New Lead, Contacted, Qualified, Proposal Sent, Negotiation, Won, Lost
  probability        Int          @default(30)
  source             String       @default("Website Inquiry")
  convertedProjectId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignedEmployee   Employee?    @relation(fields: [assignedEmployeeId], references: [id])
}

model Candidate {
  id           String   @id // e.g. "CAND-301"
  fullName     String
  appliedRole  String
  experience   String
  stage        String   @default("Applied") // Applied, Screening, Technical Test, Interview, Offer, Hired, Rejected
  rating       Float    @default(4.0)
  email        String?
  phone        String?
  recruiter    String?
  appliedDate  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================================
// 6. ATTENDANCE & LEAVES
// ============================================================================

model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  date        DateTime @default(now())
  isPresent   Boolean  @default(false)
  checkInTime String?
  mode        String   @default("Office QR") // "Office QR", "Remote", "Hybrid"
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  employeeId  String
  leaveType   String   // Casual, Medical, Annual
  startDate   DateTime
  endDate     DateTime
  daysCount   Int
  reason      String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 7. SUPPORT TICKETS
// ============================================================================

model SupportTicket {
  id          String           @id // e.g. "TCK-401"
  clientId    String?
  title       String
  clientName  String
  priority    String           @default("Medium") // Low, Medium, High, Critical
  assignedTo  String?
  stage       String           @default("New Ticket") // New Ticket, Investigating, Fixed, Closed
  sla         String           @default("12 Hours")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client      Client?          @relation(fields: [clientId], references: [id])
  responses   TicketResponse[]
}

model TicketResponse {
  id         String        @id @default(uuid())
  ticketId   String
  authorName String
  message    String
  createdAt  DateTime      @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 8. FINANCE & PAYROLL
// ============================================================================

model Invoice {
  id          String    @id @default(uuid())
  clientId    String?
  invoiceNo   String    @unique
  description String
  amount      Decimal   @db.Decimal(12, 2)
  status      String    @default("Unpaid") // Paid, Unpaid, Overdue, Cancelled
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  client      Client?   @relation(fields: [clientId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  category    String   // Payroll, Infrastructure, Tools, Office, Marketing
  description String
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @default(now())
  status      String   @default("Paid")
  createdAt   DateTime @default(now())
}

model PayrollRun {
  id          String    @id @default(uuid())
  month       String    // e.g. "Oct 2026"
  totalAmount Decimal   @db.Decimal(12, 2)
  status      String    @default("Processed")
  processedAt DateTime  @default(now())
  payslips    Payslip[]
}

model Payslip {
  id           String     @id @default(uuid())
  payrollRunId String
  employeeId   String
  basicSalary  Decimal    @db.Decimal(12, 2)
  deductions   Decimal    @default(0) @db.Decimal(12, 2)
  netSalary    Decimal    @db.Decimal(12, 2)
  status       String     @default("Paid")
  createdAt    DateTime   @default(now())

  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id])
}

// ============================================================================
// 9. AUDIT LOGS, NOTIFICATIONS & AUTOMATION RECORDS
// ============================================================================

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  taskId     Int?
  title      String
  message    String
  type       String   @default("info")
  targetRole String   @default("All")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])
  task       Task?    @relation(fields: [taskId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  userRole  String
  detail    String
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  triggerType String   // "DEADLINE_APPROACHING", "TASK_OVERDUE", "TASK_REJECTED"
  condition   String?  // JSON config
  actionType  String   // "SEND_IN_APP", "SEND_EMAIL", "ESCALATE_PM", "VOICE_CALL"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EscalationLog {
  id         String   @id @default(uuid())
  taskId     Int
  level      String   // "Project Manager", "Administrator", "Super Admin"
  reason     String
  status     String   @default("Active")
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model VoiceCallLog {
  id             String   @id @default(uuid())
  taskId         Int
  employeeCode   String
  callSid        String?
  status         String   // "queued", "ringing", "answered", "failed", "simulated"
  durationSec    Int      @default(0)
  acknowledged   Boolean  @default(false)
  createdAt      DateTime @default(now())

  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}


model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    Int
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  fromStage Int
  toStage   Int
  reason    String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, createdAt])
}
