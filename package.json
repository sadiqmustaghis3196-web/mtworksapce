{
  "name": "mt-nexus-global",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_UI_PREVIEW=true vite --host 0.0.0.0",
    "build": "VITE_UI_PREVIEW=true vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test --test-reporter=spec server/test/unit/*.test.js",
    "test:ui": "playwright test",
    "build:vercel": "npm run prisma:generate --prefix server && npm run build:production && npm run provision-admin --prefix server -- --if-needed",
    "test:deployment": "node --test tests/deployment.test.js",
    "dev:preview": "VITE_UI_PREVIEW=true vite --host 0.0.0.0",
    "build:preview": "VITE_UI_PREVIEW=true vite build",
    "prepare:production": "node scripts/prepare-production.mjs",
    "test:preview": "playwright test --config playwright.preview.config.js",
    "build:production": "VITE_UI_PREVIEW=false vite build",
    "dev:production": "VITE_UI_PREVIEW=false vite --host 0.0.0.0",
    "test:workflows": "node --test tests/workflows.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
